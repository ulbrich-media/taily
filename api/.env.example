APP_NAME=Taily
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://taily.ddev.site:5544
TAILY_FRONTEND_URL=http://taily.ddev.site:5544

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

DB_CONNECTION="mysql"
DB_HOST="db"
DB_PORT="3306"
DB_DATABASE="db"
DB_USERNAME="db"
DB_PASSWORD="db"

SESSION_DOMAIN=taily.ddev.site
SANCTUM_STATEFUL_DOMAINS=taily.ddev.site:5544

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@taily.ddev.site"
MAIL_FROM_NAME="${APP_NAME}"

# Tiervermittlung.de export (docs/features/tiervermittlung.md)
TAILY_TIERVERMITTLUNG_ENABLED=false
TAILY_TIERVERMITTLUNG_API_KEY=

# Sentry error monitoring with your own Sentry projects (docs/features/error-monitoring.md).
# Leave a DSN empty to disable Sentry for that side.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true
# Tags events with this installation's name when several share one project
SENTRY_INSTANCE=
SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_TRACES_SAMPLE_RATE=1.0
SENTRY_FRONTEND_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_FRONTEND_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Add sentry_logs to send Laravel logs to Sentry, e.g. single,sentry_logs
LOG_STACK=single
